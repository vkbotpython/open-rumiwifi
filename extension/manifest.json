{
  "manifest_version": 3,
  "name": "Open RUMIWIFI — русификатор Xiaomi роутера",
  "short_name": "Open RUMIWIFI",
  "version": "2.1.4",
  "description": "Перевод веб-панели Xiaomi и Redmi роутеров на русский язык. Работает офлайн и не меняет настройки роутера.",
  "icons": {
    "16": "img/icon_16.png",
    "32": "img/icon_32.png",
    "48": "img/icon_48.png",
    "128": "img/icon_128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "api.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lang/*.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Open RUMIWIFI",
    "default_icon": "img/icon_32.png",
    "default_popup": "popup.html"
  }
}
